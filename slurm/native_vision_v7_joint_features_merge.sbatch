#!/bin/bash
#SBATCH -J v7_joint_merge
#SBATCH -p cpu
#SBATCH -c 4
#SBATCH --mem=16G
#SBATCH -t 00:05:00
#SBATCH -o logs/%x-%j.out
set -euo pipefail
cd "${SLURM_SUBMIT_DIR:?}"
V7_JOINT_RELEASE="${1:?Pass exact joint harvest release.json}"
shift
export HF_HUB_OFFLINE=1 PYTHONNOUSERSITE=1 PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
.venv/bin/python scripts/harvest_native_vision_v7_joint_features.py --release "$V7_JOINT_RELEASE" --merge "$@"

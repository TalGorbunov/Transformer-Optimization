# ---- byte-code / packaging
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# ---- environments (.venv, .venv39, .venv_mmred, the .venv_arch symlink)
.venv*
.env
env/
venv/

# ---- editors / tools
.idea/
.vscode/
.claude/
.mypy_cache/
.pytest_cache/
.ipynb_checkpoints

# ---- data: never tracked. The official benchmark lives on /rg (lab_data/mmred); every
# data/<root> is a symlink there or to the personal /rg archive. data/README.md is the manifest.
data/*
!data/README.md
**/*.zip

# ---- SLURM logs (run_logged() tees a copy into each run dir)
logs/

# ---- outputs: run dirs are untracked; the campaign record (INDEX / STATE / CAMPAIGN_BRIEF)
# is tracked. NOTE: `outputs/*/*` (not `output*/`) — git cannot re-include a file under an
# excluded parent directory, which is why the old rule silently untracked 12 INDEX.md files.
outputs/*/*
!outputs/*/INDEX.md
!outputs/*/STATE.md
!outputs/*/CAMPAIGN_BRIEF.md
outputs_legacy
outputs_*
output_*

# ---- checkpoints: README.md (stable name -> run dir) is the record; the symlinks are local
checkpoints/*
!checkpoints/README.md

# ---- migration leftovers (sbatch/migrate/switch_symlinks.sh renames originals, never deletes)
*.moved-*
sbatch/migrate/*.submitted

# ---- generated exports (source of truth is the .md)
*.docx

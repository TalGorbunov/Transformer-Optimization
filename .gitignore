# ---- byte-code / packaging
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# ---- environments (covers .venv and the .venv_arch symlink)
.venv*
.env
env/
venv/

# ---- editors / tools
.idea/
.vscode/
.claude/
.mypy_cache/
.pytest_cache/
.ipynb_checkpoints

# ---- data (never tracked; regenerable via datasets/ generators + data/README manifest)
data/*/
!data/*.*
**/*.zip

# ---- SLURM logs (run_logged() also tees a copy into each run dir)
logs/

# ---- outputs: run artifacts are untracked, but the hand-maintained INDEX.md files ARE
# tracked (they are the "where is the canonical result" record — CLAUDE.md convention).
# output*/** also keeps the archived trees (outputs_kitkat, outputs_olds, ...) fully ignored.
output*/
!outputs/*/
!outputs/*/INDEX.md

# ---- generated exports (source of truth is the .md)
*.docx
